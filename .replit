modules = ["python-3.12"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Desktop App"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 web_app.py"
waitForPort = 5000

[[workflows.workflow]]
name = "Desktop App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 sudoku_solver_7.py"

[workflows.workflow.metadata]
outputType = "vnc"

[[ports]]
localPort = 5000
externalPort = 80
